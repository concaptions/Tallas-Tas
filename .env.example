# NODE_ENV is set by the tooling (next dev/build, vitest), not here; @tas/env defaults it to development.
# Neon Postgres connection string (main branch locally, a preview branch on PRs). TICKET-003.
DATABASE_URL=
# Clerk publishable key, safe for the browser; organisations must be enabled on the instance. TICKET-004.
# Clerk's SDK reads both keys from the process environment, which this repo-root file does not reach: for
# `pnpm dev` put them in apps/web/.env.local (gitignored) or export them (D-013). Set both or neither;
# with neither the app runs without sign-in and /app redirects to /sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key, server only. TICKET-004.
CLERK_SECRET_KEY=
# Reference only: the Clerk Organization id an agency maps to (agencies.clerk_org_id, D-003), e.g.
# org_3JlslGx68CzAw5lYX83ur3dqdAf. NO CODE READS THIS — it is not in the @tas/env schema. The active
# organization comes from the session: it is auto-selected when the person belongs to exactly one
# (components/shell/org-switcher.tsx) and chosen in the switcher otherwise. Recorded here so the id
# used when seeding or querying an agency by hand is written down somewhere the repo can see.
CLERK_DEFAULT_ORGANIZATION_ID=
# Bot token of the existing TAS Bot Slack app, used for DM notifications. Phase 5.
SLACK_BOT_TOKEN=
# Resend API key for email notifications. Phase 5.
RESEND_API_KEY=
# Inngest event key, used to send events to background jobs. Phase 2.
INNGEST_EVENT_KEY=
# Inngest signing key, used to verify requests from Inngest. Phase 2.
INNGEST_SIGNING_KEY=
# Cloudflare account id that owns the R2 bucket. Phase 4.
R2_ACCOUNT_ID=
# Access key id of the R2 API token. Phase 4.
R2_ACCESS_KEY_ID=
# Secret of the R2 API token. Phase 4.
R2_SECRET_ACCESS_KEY=
# R2 bucket name for attachments and the raw Airtable export. Phase 4.
R2_BUCKET=
# Anthropic API key for the AI spell checker. Phase 5.
ANTHROPIC_API_KEY=
# Airtable personal access token with read access to the Creative Hub bases. Phase 6.
AIRTABLE_PAT=
